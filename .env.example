# Optional target model configuration for local chat
GROQ_API_KEY=
TARGET_MODEL=openai/gpt-oss-20b
TARGET_BASE_URL=https://api.groq.com/openai/v1

# Local server configuration
PORT=4317
HOST=127.0.0.1
DATABASE_PATH=data/workshop.sqlite
PUBLIC_ORIGIN=http://127.0.0.1:4317
COOKIE_SECURE=false

# Required only for hosted PostgreSQL deployment; keep real values out of Git
DATABASE_URL=
WORKSHOP_OWNER_KEY=
WORKSHOP_SHARE_KEY=
WORKSHOP_ROOT_ENTRY=false
# Optional: hosted deployment enables owner metrics unless explicitly disabled.
# Set false to disable browser collection and owner metrics routes.
WORKSHOP_METRICS=true
# Local and hosted model submissions require recording acknowledgement.
WORKSHOP_RECORDING_REQUIRED=true
# Inception routing prefers Groq and uses Gemma when Groq is unavailable or over budget.
# This is an application planning cap, not a statement of Groq account quota.
INCEPTION_AUTO_PROVIDER=true
INCEPTION_GROQ_DAILY_TOKEN_BUDGET=200000
# Optional distinct approved Groq account for Inception only; uses the fixed Groq API host.
GROQ_SECONDARY_API_KEY=
INCEPTION_GROQ_SECONDARY_DAILY_TOKEN_BUDGET=200000
GEMINI_API_KEY=
